rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isTeacher() {
      return isSignedIn() && userDoc().data.role == "teacher";
    }
    function isSameFamily(familyId) {
      return isSignedIn() && userDoc().data.familyId == familyId;
    }
    // A teacher may act on a resource only within their own family — keeps
    // one family's teacher from reading/writing another family's data even
    // though every teacher account shares the same broad role.
    function isTeacherInFamily(familyId) {
      return isTeacher() && isSameFamily(familyId);
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // A student may only create records that belong to both themself and
    // their own family — prevents a student from writing another child's
    // data or spoofing a familyId that isn't theirs.
    function isOwnedByCallerInOwnFamily(data) {
      return isOwner(data.userId) && isSameFamily(data.familyId);
    }

    // build-order step 8.1: write narrowed from "any teacher in this family
    // may write any field" to Cloud-Function-only, matching every other
    // governed collection. The only client-side consumer of the old
    // blanket write (EndOfDayClosingPage.tsx's closing-words editor) now
    // goes through familySettings.ts#updateFamilyClosingWords, which only
    // ever touches `closingWords` on the CALLER's own family — never any
    // other field, never a client-supplied familyId.
    match /families/{familyId} {
      allow read: if isSameFamily(familyId);
      allow write: if false;
    }

    // `systemRole` (build-order step 11.2 — Account Governance Addendum) is
    // deliberately immutable from EVERY client write, including a teacher
    // editing their own or another family member's doc, and including the
    // owner themself — the invariant this whole addendum rests on is that
    // owner authority derives only from the seed/bootstrap script's admin-
    // SDK write (bypasses these rules entirely), never from anything a
    // signed-in user can send. Before this fix, `allow update: if
    // isTeacherInFamily(...)` had NO per-field restriction at all, so any
    // teacher could in principle have set `systemRole: "owner"` on their
    // own doc via a raw Firestore write the moment this field existed —
    // caught and closed in this same step, not left for later.
    match /users/{userId} {
      allow read: if isOwner(userId) || isTeacherInFamily(resource.data.familyId);
      allow create: if isTeacherInFamily(request.resource.data.familyId)
        && request.resource.data.get('systemRole', null) != "owner";
      allow update: if isTeacherInFamily(resource.data.familyId)
        && request.resource.data.get('systemRole', null) == resource.data.get('systemRole', null);
      allow delete: if isTeacherInFamily(resource.data.familyId);
    }

    match /logs/{logId} {
      allow read: if isOwner(resource.data.userId) || isTeacherInFamily(resource.data.familyId);
      allow create: if isOwnedByCallerInOwnFamily(request.resource.data)
        || isTeacherInFamily(request.resource.data.familyId);
      allow update, delete: if isTeacherInFamily(resource.data.familyId);
    }

    match /tests/{testId} {
      allow read: if isOwner(resource.data.userId) || isTeacherInFamily(resource.data.familyId);
      allow create: if isOwnedByCallerInOwnFamily(request.resource.data)
        || isTeacherInFamily(request.resource.data.familyId);
      allow update, delete: if isTeacherInFamily(resource.data.familyId);
    }

    match /uploads/{uploadId} {
      allow read: if isSameFamily(resource.data.familyId);
      allow create: if isTeacherInFamily(request.resource.data.familyId);
      allow update, delete: if isTeacherInFamily(resource.data.familyId);
    }

    // Ingestion flow (drop-in text -> Claude parse -> teacher review/confirm)
    // runs entirely through teacher-invoked Cloud Functions, so client
    // writes to this collection are teacher-only, matching uploads/.
    match /extracurriculars/{recordId} {
      allow read: if isOwner(resource.data.userId) || isTeacherInFamily(resource.data.familyId);
      allow create: if isTeacherInFamily(request.resource.data.familyId);
      allow update, delete: if isTeacherInFamily(resource.data.familyId);
    }

    // Day plans (AI-drafted via the generatePlan callable, teacher-reviewed,
    // then saved directly by the client like logs/tests). A teacher can see
    // every plan in their family at any time; a student can only see a plan
    // that names them once its date has arrived — never a day ahead, per the
    // "teacher gets it a day ahead, student gets it day-of" requirement.
    match /dayPlans/{planId} {
      allow read: if isTeacherInFamily(resource.data.familyId)
        || (isSignedIn()
            && resource.data.studentIds.hasAny([request.auth.uid])
            && resource.data.date <= request.time);
      allow create: if isTeacherInFamily(request.resource.data.familyId);
      allow update, delete: if isTeacherInFamily(resource.data.familyId);
    }

    // Per-objective mastery tracking (learn_practice_test_alignment_standard_v2).
    // Only ever written by Cloud Functions (admin SDK, bypasses these rules) —
    // submitPlacementTest today, the daily continuous-reassessment loop later.
    match /masteryRecords/{recordId} {
      allow read: if isOwner(resource.data.userId) || isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // Placement-test / printable-check-in audit trail (Assessment 2.0),
    // written only by submitPlacementTest / submitPrintableCheckIn.
    match /placementTests/{recordId} {
      allow read: if isOwner(resource.data.userId) || isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // Raw student-entered placement answers awaiting a teacher's review of
    // the open-ended items — written only by submitPlacementResponses
    // (admin SDK, bypasses these rules). The teacher's client deletes the
    // doc directly once it's been reviewed and finalized into
    // placementTests via submitPlacementTest.
    match /placementSubmissions/{submissionId} {
      allow read: if isOwner(resource.data.userId) || isTeacherInFamily(resource.data.familyId);
      allow delete: if isTeacherInFamily(resource.data.familyId);
      allow create, update: if false;
    }

    // Generalized teacher-approval primitive (functions/src/approvals.ts) —
    // proposal -> pending review -> approve/reject -> committed version ->
    // audit event. Written only by createProposal/approveProposal/
    // rejectProposal (admin SDK, bypasses these rules); every existing
    // ad hoc review flow (day plans, extracurriculars, placement
    // submissions) still manages its own state for now.
    match /proposals/{proposalId} {
      allow read: if isTeacherInFamily(resource.data.familyId) ||
        (resource.data.targetUserId != null && isOwner(resource.data.targetUserId));
      allow write: if false;
    }
    match /auditEvents/{eventId} {
      allow read: if isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // Quarter + weekly certification (build-order step 3, revised 3.1 —
    // FAMILY-level instructional package, per-kid hashes preserved inside
    // each doc's childContent field for traceability), written only by
    // certifyQuarter/certifyWeek/bootstrapExistingCertifications
    // (functions/src/certification.ts, via the approval primitive above —
    // admin SDK, bypasses these rules). Teacher-only read, same trust level
    // as curriculumContent — these records are a curriculum-readiness
    // concern, not a student's own record, so no owner-read clause.
    match /familyQuarterCertifications/{certId} {
      allow read: if isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }
    match /familyWeeklyCertifications/{certId} {
      allow read: if isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // Explicit teacher-declared day designations (build-order step 3.1) —
    // the only way a date is ever represented as an approved alternative-
    // package or non-instructional (PTO/break) day to the certification
    // gate; never inferred. Written only by designateDay
    // (functions/src/certification.ts, via the approval primitive above).
    match /dayDesignations/{designationId} {
      allow read: if isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // Two-day-ahead governed daily proposals (build-order step 4), written
    // only by generateProposedDays/approveProposedDay
    // (functions/src/proposedDays.ts, via the approval primitive above —
    // admin SDK, bypasses these rules). Stays teacher-only FOREVER, by
    // design (build-order step 11, section 2) — a student's Today
    // experience never reads this collection at all, even once approved.
    // Instead, approveProposedDay writes a separate, narrow, explicitly-
    // filtered student-safe projection into `publishedDays` below, in the
    // same transaction — see curriculum/publishedDay.ts. This keeps a
    // draft/superseded/edited-before-approval/sibling day structurally
    // unreachable from a student's rules, rather than relying on this
    // collection's own field shape to hide anything from them.
    match /proposedDays/{proposedDayId} {
      allow read: if isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // Student-safe published day (build-order step 11) — the ONE thing a
    // student ever reads about their own school day. Written only by
    // approveProposedDay (functions/src/proposedDays.ts, admin SDK,
    // bypasses these rules) from an explicit field-by-field projection
    // that never includes governance metadata, teacher notes, or any
    // other family member's day. One doc per (family, student, date),
    // written once at approval and never mutated afterward.
    match /publishedDays/{docId} {
      allow read: if isOwner(resource.data.studentId) || isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // A student's own "not started / in progress / completed" signal per
    // block (build-order step 11, sections 5/6) — written only by
    // studentProgress.ts's updateBlockProgress (admin SDK, bypasses these
    // rules), because it needs to validate the referenced day/block and
    // (when relevant) mirror into an open evidence packet, which a
    // client-side rule can't express. A student may read only their own;
    // a teacher may read any in their family (the same starting point
    // they'll see once they open the matching evidence packet).
    match /studentBlockProgress/{docId} {
      allow read: if isOwner(resource.data.studentId) || isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // End-of-day evidence/completion/actual-instructional-time packets
    // (build-order step 6), written only by evidencePackets.ts's
    // openEvidencePacket/saveEvidencePacketDraft/approveEvidencePacket(s)
    // (via the approval primitive above — admin SDK, bypasses these
    // rules). Teacher-only for now, same reasoning as proposedDays: no
    // student-facing view of their own evidence exists yet, so there's
    // no owner-read clause here either — add one when that view is
    // actually built.
    match /evidencePackets/{packetId} {
      allow read: if isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // Exactly-once mastery-application guard + historical traceability
    // record (build-order step 6.2) — one doc per (evidence packet,
    // evidence item) actually applied to a mastery record, written only
    // by curriculum/evidenceMastery.ts's applyEligibleEvidenceToMastery
    // (admin SDK, bypasses these rules, inside the same transaction as
    // the masteryRecords write it caused). Same teacher-only reasoning as
    // masteryRecords/evidencePackets above.
    match /masteryApplications/{applicationId} {
      allow read: if isOwner(resource.data.userId) || isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // Database-backed curriculum content (the "upload a new quarter" flow).
    // Written directly by the teacher's client after a local, deterministic
    // parse — no Cloud Function in the loop, same trust level as logs/tests.
    // generatePlan reads this via the admin SDK, bypassing these rules.
    match /curriculumContent/{docId} {
      allow read: if isTeacherInFamily(resource.data.familyId);
      allow create: if isTeacherInFamily(request.resource.data.familyId);
      allow update, delete: if isTeacherInFamily(resource.data.familyId);
    }

    // Ask-a-Teacher help requests (build-order step 9) — written only by
    // createHelpRequest/respondToHelpRequest/resolveHelpRequest/
    // escalateHelpRequest (functions/src/identity/helpRequests.ts, admin
    // SDK, bypasses these rules), because creation needs a server-side
    // owner-or-teacher check plus canned-message/category validation that
    // a client-side rule can't express, and every mutation after that is
    // teacher-only. Read-only here: a student may read their OWN requests
    // (never a sibling's — the core privacy requirement), a teacher may
    // read every request in their family regardless of escalation level
    // (there's no finer-grained teacher sub-role in this app to split
    // "Celeste's queue" from "Jasper's queue" at the rules layer; that
    // split is UI-level grouping only — see the step 9 report).
    match /helpRequests/{requestId} {
      allow read: if isOwner(resource.data.studentId) || isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }

    // Curriculum Quality Feedback Queue (build-order step 10) — written
    // only by createQualityIssue/quarantineContentVersion/
    // resolveQualityIssue/releaseQuarantine/updateQualityIssueSeverity
    // (functions/src/curriculumQualityIssues.ts, admin SDK, bypasses
    // these rules), because creation needs a server-side resolution of
    // the referenced content version (and, when linked, the referenced
    // help request) that a client-side rule can't express. Teacher-only
    // read, deliberately with NO owner-read clause at all — spec section
    // 12: "Students should not browse the Quality Feedback Queue," full
    // stop, unlike helpRequests above which a student reads their own of.
    match /curriculumQualityIssues/{issueId} {
      allow read: if isTeacherInFamily(resource.data.familyId);
      allow write: if false;
    }
  }
}
