{
  "name": "wbk-homeschool-functions",
  "version": "1.0.0",
  "private": true,
  "description": "WBK Homeschool Ecosystem — Phase 1 Cloud Functions (dashboard calculations, extracurricular ingestion)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-curriculum-data.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint --ext .ts src",
    "test": "tsc --noEmit",
    "test:unit": "npm run build && node --test $(find lib -name '*.test.js')"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3"
  }
}
